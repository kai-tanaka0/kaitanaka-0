name: Build Android APK
on:
  push:
    branches: [ main, master ]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
    - name: Checkout Source Code
      uses: actions/checkout@v4

    - name: Set up Java/JDK
      uses: actions/setup-java@v4
      with:
        distribution: 'zulu'
        java-version: '17'

    - name: Set up Android SDK
      uses: android-actions/setup-android@v3

    - name: Set up Node.js
      uses: actions/setup-node@v4
      with:
        node-version: '22'

    - name: Install Cordova & Build App
      run: |
        npm install -g cordova
        cordova create build_tmp it.undo.kanaka.kaitanaka "Kai Tanaka"
        
        # Clear out the default Cordova placeholder files
        rm -rf build_tmp/www/*
        
        # Copy absolutely EVERYTHING from your repo into the app bundle
        cp -r * build_tmp/www/ 2>/dev/null || true
        
        # Move the config file to its proper place and clean up the destination
        mv build_tmp/www/config.xml build_tmp/config.xml
        rm -rf build_tmp/www/build_tmp
        rm -rf build_tmp/www/.github
        rm -rf build_tmp/www/.git
        
        cd build_tmp
        cordova platform add android
        cordova build android --no-telemetry

    - name: Upload Finished APK
      uses: actions/upload-artifact@v4
      with:
        name: Kai-Tanaka-App
        path: build_tmp/platforms/android/app/build/outputs/apk/debug/app-debug.apk

